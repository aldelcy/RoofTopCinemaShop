# Leave this empty for local development. The dev server is served from /.
#
# On Webflow Cloud, set this to the environment mount path, including the
# leading slash, for example /tickets. It must match the mount path exactly.
# Next.js already prefixes Link, useRouter, redirect, and next/image.
# This variable is only for plain <img> src values.
#
# NEXT_PUBLIC_ values are inlined into browser JavaScript. Never put a secret
# in a NEXT_PUBLIC_ variable. Mark real secrets as Secret in Webflow Cloud and
# read them only from server code.
NEXT_PUBLIC_BASE_PATH=
